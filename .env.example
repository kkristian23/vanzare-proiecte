# Optional. Leave blank to disable analytics entirely. Use a real GA4 web stream ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase web application configuration (public, not Admin credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local emulator tests only; use demo-monodev as project ID.
VITE_FIREBASE_EMULATORS=false
