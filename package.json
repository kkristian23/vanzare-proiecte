{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <24"
  },
  "scripts": {
    "audit:serve": "node scripts/serve-audit.mjs",
    "audit:http": "node scripts/audit-showcase.mjs --phase=http --base=http://127.0.0.1:4010 --output=reports/showcase-audit/final",
    "audit:browser": "node scripts/audit-showcase.mjs --phase=browser --base=http://127.0.0.1:4010 --output=reports/showcase-audit/final",
    "audit:report": "node scripts/audit-report.mjs",
    "audit:regression": "node --test --test-concurrency=1 tests/showcase-regressions.test.mjs tests/showcase-completion.test.mjs tests/showcase-controls.test.mjs tests/showcase-secondary-controls.test.mjs tests/showcase-navigation.test.mjs tests/showcase-garden-tools.test.mjs tests/showcase-audit-resume.test.mjs tests/showcase-archi-actions.test.mjs",
    "audit:source": "node scripts/audit-control-source.mjs",
    "audit:recheck": "node scripts/audit-recheck.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "audit:translations": "node scripts/audit-translations.mjs",
    "audit:showcase-locales": "node scripts/audit-showcase-locales.mjs",
    "audit:bandwidth": "node scripts/audit-bandwidth.mjs",
    "audit:network": "node scripts/audit-network.mjs --base=http://127.0.0.1:3000",
    "optimize:png": "node scripts/optimize-png-lossless.mjs",
    "optimize:project-images": "node scripts/optimize-project-images.mjs --threshold-kb=250 --include-source-images",
    "dev": "node scripts/start-server.mjs dev",
    "prebuild": "node scripts/project-previews.mjs",
    "build": "vinext build",
    "showcase:sync": "node scripts/sync-showcase.mjs",
    "showcase:favicons": "node scripts/apply-showcase-favicons.mjs",
    "showcase:refresh": "npm run showcase:sync -- --build --strict && npm run build",
    "start": "node scripts/start-server.mjs start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/normalize-next-export.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "audit:interactions:recheck": "node scripts/audit-interactions-recheck.mjs",
    "audit:batches": "node scripts/audit-batches.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.32.0",
    "magic-string": "0.30.17",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
